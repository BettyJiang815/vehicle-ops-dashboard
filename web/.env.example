# 复制为 .env.local 后按需修改
#
# 一、只看界面（不装数据库）：保持 DEMO_MODE=true 即可，
#    页面会读 web/public/demo/*.json 里的演示数据。
VITE_DEMO_MODE=true

# 二、接真数据库：把 DEMO_MODE 改成 false，并填下面两项
#    （本地 docker compose 用的是这组默认值）
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzM1Njg5NjAwLCJleHAiOjIwNTEyMjI0MDB9.jnYSCR7WDTK0pSxiFFAq_t41MQbo1hq6h2zsuTDONA8

# 三、可选：卡片上的外部链接模板。不填就不显示对应按钮。
#    可用占位符：{vin} {name} {plate} {alias} {heartbeat} {dayStart} {dayEnd}
#    例：VITE_MONITOR_URL_TEMPLATE=https://your-platform.example.com/live?vin={vin}&t={heartbeat}
VITE_MONITOR_URL_TEMPLATE=
VITE_TASK_URL_TEMPLATE=
VITE_VEHICLE_SOURCE_URL=
